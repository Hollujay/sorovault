# Copy to .env and adjust. Only DATABASE_URL has no usable default.

# Postgres connection string for the registry. Required.
DATABASE_URL=postgres://sorovault:sorovault@localhost:5432/sorovault?sslmode=disable

# Alternatively, read the connection string from a mounted secret file. Do not
# set both at once.
# DATABASE_URL_FILE=/run/secrets/sorovault-db-url

# Stellar RPC endpoint contract code is read from.
RPC_URL=https://soroban-testnet.stellar.org

# The network you expect RPC_URL to serve. SoroVault reads the real
# passphrase from the endpoint and refuses to start work if it disagrees, so
# a stale RPC_URL cannot file mainnet contracts under "testnet".
#
#   testnet    Test SDF Network ; September 2015
#   mainnet    Public Global Stellar Network ; September 2015
#   futurenet  Test SDF Future Network ; October 2022
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Listen address for the JSON API and browse UI.
HTTP_ADDR=:8080

# How many registrations and refreshes may run at once, across every client.
# Each one holds a WASM module in memory while it decodes, so this is what
# keeps peak memory finite. Unset means 4.
# MAX_CONCURRENT_REGISTRATIONS=4

# debug | info | warn | error
LOG_LEVEL=info

# text | json. json emits one parseable object per line, with fields a log
# system can query (such as contract_id, network and wasm_hash).
LOG_FORMAT=text

# Registrations and refreshes allowed per client per minute, and how many may
# arrive at once. Reads and the browse UI are not rate-limited.
# RATE_LIMIT_PER_MINUTE=30
# RATE_LIMIT_BURST=10

# Trust the first X-Forwarded-For address as the client. Only enable this
# behind a proxy you control; otherwise callers can forge their address and
# escape the rate limit.
# TRUST_X_FORWARDED_FOR=false

# Comma-separated exact browser origins allowed to call the API, for example:
#   CORS_ORIGINS=https://app.example.com,http://localhost:3000
# Unset sends no CORS headers. "*" allows any origin to read GET routes, but
# never opens the POST routes, which spend RPC calls and database writes.
# CORS_ORIGINS=https://app.example.com

# How long a single contract fetch may take.
RPC_TIMEOUT=30s

# How often `serve` re-checks registered contracts for upgrades. 0 turns
# automatic refresh off; otherwise at least 1m.
REFRESH_INTERVAL=0

# Where a refresh posts a JSON message whenever it finds an upgraded
# contract. Unset means no messages are sent.
# REFRESH_WEBHOOK_URL=https://hooks.example.com/sorovault

# Shared secret that signs webhook payloads with HMAC-SHA256. The signature
# is sent in the X-SoroVault-Signature header, over the raw request body.
# Unset means the payloads are not signed.
# REFRESH_WEBHOOK_SECRET=change-me

# Only read by the test suite: point it at a throwaway Postgres to run the
# store conformance suite against the real database. Unset, those cases skip.
# TEST_DATABASE_URL=postgres://sorovault:sorovault@localhost:55433/sorovault?sslmode=disable

# Follow the network's contract-upgrade events and refresh a contract as soon
# as it is upgraded. Needs REFRESH_INTERVAL too: polling stays on as the
# safety net behind the events.
# REFRESH_EVENTS=true
# REFRESH_EVENTS_INTERVAL=10s

# Sign interface responses (see `sorovault keygen`), and keep earlier public
# keys published at GET /api/keys after a rotation.
# SIGNING_KEY=
# SIGNING_RETIRED_KEYS=

# Public HTTP(S) origin used for Open Graph URLs and XML sitemaps.
# When unset, the sitemap endpoints return 404.
# PUBLIC_URL=https://registry.example.org
